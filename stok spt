<script>
(function(){
const $ = (s) => document.querySelector(s);
const S = { barang:{}, mutasi:[], opname:[], db:null, dl:null, canWrite:true, loaded:{barang:false,mutasi:false,opname:false},
  filter:'semua', draft:{}, editKode:null, preset:'bulan', dari:'', sampai:'', pending:0, lastSave:null };

/* ---------- format & tanggal ---------- */
const fInt = (n) => Number(n||0).toLocaleString('id-ID');
const fRp = (n) => 'Rp ' + Math.round(Number(n)||0).toLocaleString('id-ID');
const fRpS = (n) => { const a=Math.abs(n); const s=n<0?'−':''; if(a>=1e9) return s+'Rp '+(a/1e9).toLocaleString('id-ID',{maximumFractionDigits:2})+' M'; if(a>=1e6) return s+'Rp '+(a/1e6).toLocaleString('id-ID',{maximumFractionDigits:1})+' jt'; return s+'Rp '+Math.round(a).toLocaleString('id-ID'); };
const fM3 = (n,d=3) => (Number(n)||0).toLocaleString('id-ID',{minimumFractionDigits:d,maximumFractionDigits:d});
const fSigned = (n) => n>0 ? '+'+fInt(n) : n<0 ? '−'+fInt(-n) : '0';
const BLN = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
const BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const HARI = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
const HR = ['Min','Sen','Sel','Rab','Kam','Jum','Sab'];
const pD = (s) => { const [y,m,d]=s.split('-').map(Number); return new Date(y,m-1,d); };
const iso = (d) => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
const todayStr = () => iso(new Date());
const addDays = (s,n) => { const d=pD(s); d.setDate(d.getDate()+n); return iso(d); };
const dayDiff = (a,b) => Math.round((pD(b)-pD(a))/864e5);
const lastOfMonth = (y,m) => iso(new Date(y,m,0)); // m 1-based
const fTgl = (s) => { if(!s) return '—'; const d=pD(s); return `${HR[d.getDay()]}, ${d.getDate()} ${BLN[d.getMonth()]} ${d.getFullYear()}`; };
const fTglPanjang = (s) => { const d=pD(s); return `${HARI[d.getDay()]}, ${d.getDate()} ${BULAN[d.getMonth()]} ${d.getFullYear()}`; };
const vol = (b) => b ? (Number(b.tebal)||0)*(Number(b.lebar)||0)*(Number(b.panjang)||0)/10000 : 0;
const dec1 = (n) => fM3(n,1).replace(/,0$/,'');
const ukuran = (b) => (b && b.tebal && b.lebar) ? `${dec1(b.tebal)}×${dec1(b.lebar)} cm × ${dec1(b.panjang)} m` : '—';
const esc = (s) => String(s??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let toastT; const toast=(m)=>{const t=$('#toast');t.textContent=m;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>t.hidden=true,3000);};
const byTgl = (a,b) => (b.tanggal||'').localeCompare(a.tanggal||'')||(b.dibuat||'').localeCompare(a.dibuat||'');
$('#today').textContent = 'Hari ini ' + fTglPanjang(todayStr());

/* ---------- status simpan ---------- */
function setSync(s){ const el=$('#sync'); el.dataset.s=s;
  const jam = S.lastSave ? ` · ${String(S.lastSave.getHours()).padStart(2,'0')}:${String(S.lastSave.getMinutes()).padStart(2,'0')}` : '';
  $('#syncTxt').textContent = s==='ok' ? 'Tersimpan di perangkat ini'+jam : s==='saving' ? 'Menyimpan…' : s==='err' ? 'Gagal menyimpan, coba lagi' : 'Browser ini tidak bisa menyimpan data'; }
async function tulis(fn){ S.pending++; setSync('saving');
  try{ await fn(); S.pending--; S.lastSave=new Date(); if(!S.pending) setSync('ok'); }
  catch(e){ S.pending--; setSync('err'); throw e; } }

/* ---------- periode ---------- */
const inP = (t) => (!S.dari || t>=S.dari) && (!S.sampai || t<=S.sampai);
const beforeP = (t) => !!S.dari && t<S.dari;
function applyPreset(p){ const t=todayStr(), d=pD(t); S.preset=p;
  if(p==='hari'){ S.dari=t; S.sampai=t; }
  else if(p==='7hari'){ S.dari=addDays(t,-6); S.sampai=t; }
  else if(p==='bulan'){ S.dari=iso(new Date(d.getFullYear(),d.getMonth(),1)); S.sampai=lastOfMonth(d.getFullYear(),d.getMonth()+1); }
  else if(p==='tahun'){ S.dari=`${d.getFullYear()}-01-01`; S.sampai=`${d.getFullYear()}-12-31`; }
  else if(p==='semua'){ S.dari=''; S.sampai=''; } }
const isFullMonth = () => S.dari && S.sampai && S.dari.endsWith('-01') && S.sampai===lastOfMonth(+S.dari.slice(0,4),+S.dari.slice(5,7));
const isFullYear = () => S.dari && S.sampai && S.dari.endsWith('-01-01') && S.sampai===S.dari.slice(0,4)+'-12-31';
function shift(dir){
  if(!S.dari||!S.sampai) return;
  if(isFullYear()){ const y=+S.dari.slice(0,4)+dir; S.dari=`${y}-01-01`; S.sampai=`${y}-12-31`; }
  else if(isFullMonth()){ const d=new Date(+S.dari.slice(0,4),+S.dari.slice(5,7)-1+dir,1); S.dari=iso(d); S.sampai=lastOfMonth(d.getFullYear(),d.getMonth()+1); }
  else { const n=dayDiff(S.dari,S.sampai)+1; S.dari=addDays(S.dari,dir*n); S.sampai=addDays(S.sampai,dir*n); }
  S.preset='custom'; periodeChanged(); }
function periodLabel(){
  if(!S.dari && !S.sampai) return 'Semua tanggal';
  if(isFullYear()) return 'Tahun '+S.dari.slice(0,4);
  if(isFullMonth()) return `${BULAN[+S.dari.slice(5,7)-1]} ${S.dari.slice(0,4)}`;
  if(S.dari===S.sampai) return fTglPanjang(S.dari);
  return `${S.dari?fTglPanjang(S.dari):'Awal'} – ${S.sampai?fTglPanjang(S.sampai):'sekarang'}`; }
function renderPeriode(){
  document.querySelectorAll('[data-preset]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.preset===S.preset)));
  if(document.activeElement!==$('#pDari')) $('#pDari').value=S.dari;
  if(document.activeElement!==$('#pSampai')) $('#pSampai').value=S.sampai;
  if(document.activeElement!==$('#pBulan')) $('#pBulan').value = isFullMonth() ? S.dari.slice(0,7) : '';
  $('#pLabel').textContent='Periode: '+periodLabel();
  $('#pLen').textContent = (S.dari&&S.sampai) ? `(${fInt(dayDiff(S.dari,S.sampai)+1)} hari)` : '';
  const can=!!(S.dari&&S.sampai); $('#pPrev').disabled=!can; $('#pNext').disabled=!can; }
function periodeChanged(){ try{ localStorage.setItem('gk-periode',JSON.stringify({preset:S.preset,dari:S.dari,sampai:S.sampai})); }catch(e){} renderAll(); }
(function initPeriode(){ let saved=null; try{ saved=JSON.parse(localStorage.getItem('gk-periode')||'null'); }catch(e){}
  if(saved && saved.preset && saved.preset!=='custom') applyPreset(saved.preset);
  else if(saved && saved.preset==='custom'){ S.preset='custom'; S.dari=saved.dari||''; S.sampai=saved.sampai||''; }
  else applyPreset('bulan'); })();
document.querySelectorAll('[data-preset]').forEach(b=>b.addEventListener('click',()=>{ applyPreset(b.dataset.preset); periodeChanged(); }));
$('#pBulan').addEventListener('change',()=>{ const v=$('#pBulan').value; if(!/^\d{4}-\d{2}$/.test(v)) return; const [y,m]=v.split('-').map(Number);
  S.dari=`${v}-01`; S.sampai=lastOfMonth(y,m); S.preset='custom'; periodeChanged(); });
const validDate = (el) => el.value && el.validity.valid && +el.value.slice(0,4)>=2000;
$('#pDari').addEventListener('change',()=>{ const el=$('#pDari'); if(el.value && !validDate(el)) return; S.dari=el.value; if(S.dari&&S.sampai&&S.dari>S.sampai) S.sampai=S.dari; S.preset='custom'; periodeChanged(); });
$('#pSampai').addEventListener('change',()=>{ const el=$('#pSampai'); if(el.value && !validDate(el)) return; S.sampai=el.value; if(S.dari&&S.sampai&&S.dari>S.sampai) S.dari=S.sampai; S.preset='custom'; periodeChanged(); });
['#pDari','#pSampai','#pBulan'].forEach(s=>$(s).addEventListener('blur',renderPeriode));
$('#pPrev').addEventListener('click',()=>shift(-1));
$('#pNext').addEventListener('click',()=>shift(1));

/* ---------- compute ---------- */
// mode 'periode': awal = sebelum periode, mutasi dalam periode; mode 'sekarang': semua data; mode {sampai}: semua s.d. tanggal itu
function compute(mode){
  const sampaiTgl = mode && mode.sampai;
  const usePeriod = mode==='periode';
  const rows = {};
  for (const k in S.barang){ const b=S.barang[k]; rows[k]={kode:k,b,awal:Number(b.stok_awal)||0,masuk:0,keluar:0,adj:0}; }
  const take = (t, fn) => { t=t||''; if(usePeriod){ if(beforeP(t)) fn('awal'); else if(inP(t)) fn('in'); } else if(sampaiTgl){ if(t<=sampaiTgl) fn('in'); } else fn('in'); };
  for (const m of S.mutasi){ const r=rows[m.kode]; if(!r) continue; const q=Number(m.qty)||0, sg=m.tipe==='masuk'?1:-1;
    take(m.tanggal, (w)=>{ if(w==='awal') r.awal+=sg*q; else if(sg>0) r.masuk+=q; else r.keluar+=q; }); }
  for (const o of S.opname){ for(const it of (o.items||[])){ const r=rows[it.kode]; if(!r) continue; const s=Number(it.selisih)||0;
    take(o.tanggal, (w)=>{ if(w==='awal') r.awal+=s; else r.adj+=s; }); } }
  for (const k in rows){ const r=rows[k]; r.stok=r.awal+r.masuk-r.keluar+r.adj; r.vol=r.stok*vol(r.b); r.nilai=r.stok*(Number(r.b.harga_beli)||0);
    const min=Number(r.b.stok_min)||0; r.status = r.stok<=0?'Habis':(r.stok<=min?'Menipis':'Aman'); }
  return rows;
}
const statusCls = {Aman:'ok',Menipis:'warn',Habis:'bad'};
const statusRank = {Habis:0,Menipis:1,Aman:2};
const contohTag = (o) => o && o.contoh ? '<span class="chip-contoh">CONTOH</span>' : '';
const namaB = (k) => { const b=S.barang[k]; return b ? b.nama : k; };
const mutasiP = () => S.mutasi.filter(m=>inP(m.tanggal||''));

/* ---------- render ---------- */
function renderAll(){
  const R = compute('periode'), Rnow = compute();
  renderPeriode(); renderBanner(); renderKpi(R); renderChart(); renderRecent(); renderStok(R);
  renderSelects(Rnow); renderList('masuk'); renderList('keluar'); renderOpname(); renderHist(); renderMaster();
  stokInfo(Rnow);
}
function renderBanner(){
  const any = Object.values(S.barang).some(b=>b.contoh) || S.mutasi.some(m=>m.contoh) || S.opname.some(o=>o.contoh);
  $('#contohBanner').hidden = !any || !S.canWrite;
}
function renderKpi(R){
  const rs = Object.values(R);
  if(!(S.loaded.barang && S.loaded.mutasi && S.loaded.opname)) return;
  if(!rs.length){ $('#takeaway').textContent='Belum ada barang. Mulai dari tab Master barang, lalu catat barang masuk dan keluar.';
    ['#kNilai','#kVol','#kMasuk','#kKeluar','#kRestock','#kSelisih'].forEach(s=>$(s).textContent='—'); return; }
  const nilai=rs.reduce((a,r)=>a+r.nilai,0), v=rs.reduce((a,r)=>a+r.vol,0), q=rs.reduce((a,r)=>a+r.stok,0);
  const mp=mutasiP(); let vin=0,vout=0,qin=0,qout=0,rpOut=0;
  for(const m of mp){ const b=S.barang[m.kode]; if(!b) continue; const qq=Number(m.qty)||0;
    if(m.tipe==='masuk'){ vin+=qq*vol(b); qin+=qq; } else { vout+=qq*vol(b); qout+=qq; rpOut+=qq*(Number(m.harga)||0); } }
  const restock = rs.filter(r=>r.status!=='Aman').sort((a,b)=>statusRank[a.status]-statusRank[b.status]);
  const akhir = S.sampai ? fTgl(S.sampai) : 'hari ini';
  $('#kNilai').textContent=fRpS(nilai); $('#kNilai').title=fRp(nilai); $('#kNilaiSub').textContent=`per ${akhir}, harga beli`;
  $('#kVol').textContent=fM3(v,2); $('#kQty').textContent=`m³ · ${fInt(q)} batang`;
  $('#kMasuk').textContent=fM3(vin,2); $('#kMasukSub').textContent=`m³ · ${fInt(qin)} batang`;
  $('#kKeluar').textContent=fM3(vout,2); $('#kKeluarSub').textContent=`m³ · ${fInt(qout)} btg · ${fRpS(rpOut)}`;
  $('#kRestock').textContent=restock.length; $('#kRestockBox').classList.toggle('alert',restock.length>0);
  const op=S.opname.filter(o=>inP(o.tanggal||'')); const its=op.flatMap(o=>o.items||[]);
  if(op.length){ const sel=its.reduce((a,i)=>a+(Number(i.selisih)||0),0);
    const nv=its.reduce((a,i)=>a+(Number(i.selisih)||0)*(Number((S.barang[i.kode]||{}).harga_beli)||0),0);
    $('#kSelisih').textContent=fSigned(sel); $('#kSelisih').className='val '+(sel<0?'neg':sel>0?'pos':'');
    $('#kSelisihSub').textContent=`${op.length}× opname · ${fRpS(nv)}`; }
  else { $('#kSelisih').textContent='—'; $('#kSelisih').className='val'; $('#kSelisihSub').textContent='tidak ada opname di periode ini'; }
  let t = `${periodLabel()}: masuk ${fM3(vin,2)} m³, keluar ${fM3(vout,2)} m³. `;
  if(!restock.length) t+=`Semua ${rs.length} barang dalam stok aman per ${akhir}.`;
  else { const names=restock.slice(0,3).map(r=>`${r.b.nama} (${fInt(r.stok)} ${r.b.satuan||'btg'})`).join(', ');
    t+=`${restock.length} barang perlu dipesan ulang: ${names}${restock.length>3?', dan lainnya':''}.`; }
  $('#takeaway').textContent=t;
}
function niceStep(raw){ const p=Math.pow(10,Math.floor(Math.log10(raw))); const f=raw/p; return (f<=1?1:f<=2?2:f<=5?5:10)*p; }
function chartBuckets(){
  const dates=S.mutasi.map(m=>m.tanggal).filter(Boolean).sort();
  let end = S.sampai || todayStr(); if(!S.sampai && dates.length && dates[dates.length-1]>end) end=dates[dates.length-1];
  let start = S.dari || (dates[0] || addDays(end,-180));
  if(start>end) start=end;
  const days=dayDiff(start,end)+1;
  if(days<=62){ const out=[]; for(let i=0;i<days;i++){ const k=addDays(start,i); const d=pD(k); out.push({k, from:k, to:k, lbl:`${d.getDate()} ${BLN[d.getMonth()]}`, full:fTglPanjang(k)}); } return {unit:'hari',out}; }
  const out=[]; let y=+start.slice(0,4), m=+start.slice(5,7); const ey=+end.slice(0,4), em=+end.slice(5,7);
  while(y<ey || (y===ey && m<=em)){ const k=`${y}-${String(m).padStart(2,'0')}`; out.push({k, from:k+'-01', to:lastOfMonth(y,m), lbl:`${BLN[m-1]} ${String(y).slice(2)}`, full:`${BULAN[m-1]} ${y}`}); m++; if(m>12){m=1;y++;} }
  return {unit:'bulan', out: out.slice(-24)};
}
function renderChart(){
  const el=$('#chart'); if($('#ringkasan').hidden) return;
  const W=Math.max(300,el.clientWidth||600), H=240, m={t:14,r:8,b:28,l:44};
  const {unit,out}=chartBuckets(); const data=out.map(b=>({...b,masuk:0,keluar:0}));
  for(const x of S.mutasi){ const t=x.tanggal||''; const b=data.find(d=>t>=d.from && t<=d.to); if(!b) continue; const v=(Number(x.qty)||0)*vol(S.barang[x.kode]); b[x.tipe==='masuk'?'masuk':'keluar']+=v; }
  $('#chartNote').textContent = `Volume kayu (m³) per ${unit} · ${periodLabel()}`;
  const max=Math.max(0.0001,...data.map(d=>Math.max(d.masuk,d.keluar)));
  const step=niceStep(max/4); const top=Math.ceil(max/step)*step;
  const iw=W-m.l-m.r, ih=H-m.t-m.b, gw=iw/Math.max(1,data.length), bw=Math.max(1.5,Math.min(28,(gw-Math.min(14,gw*.3))/2));
  const every=Math.max(1,Math.ceil(46/gw));
  const y=(v)=>m.t+ih-(v/top)*ih;
  let s=`<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="Volume masuk dan keluar per ${unit}">`;
  for(let v=0; v<=top+1e-9; v+=step){ s+=`<line x1="${m.l}" x2="${W-m.r}" y1="${y(v)}" y2="${y(v)}" stroke="var(--line)" stroke-width="1"/>`;
    s+=`<text x="${m.l-6}" y="${y(v)+4}" text-anchor="end" font-size="11" fill="var(--muted)" font-family="var(--font-mono)">${fM3(v,step<1?1:0)}</text>`; }
  data.forEach((d,i)=>{ const cx=m.l+gw*i+gw/2; const h1=ih*(d.masuk/top), h2=ih*(d.keluar/top);
    s+=`<g class="grp" data-i="${i}"><rect x="${m.l+gw*i}" y="${m.t}" width="${gw}" height="${ih}" fill="transparent"/>`;
    s+=`<rect x="${cx-bw-1}" y="${m.t+ih-h1}" width="${bw}" height="${Math.max(0,h1)}" rx="${Math.min(3,bw/2)}" fill="var(--accent)"/>`;
    s+=`<rect x="${cx+1}" y="${m.t+ih-h2}" width="${bw}" height="${Math.max(0,h2)}" rx="${Math.min(3,bw/2)}" fill="var(--grain)"/>`;
    if(i%every===0) s+=`<text x="${cx}" y="${H-8}" text-anchor="middle" font-size="11.5" fill="var(--muted)">${d.lbl}</text>`;
    s+=`</g>`; });
  if(!S.mutasi.some(x=>data.some(d=>(x.tanggal||'')>=d.from && (x.tanggal||'')<=d.to))) s+=`<text x="${m.l+iw/2}" y="${m.t+ih/2}" text-anchor="middle" font-size="13" fill="var(--muted)">Tidak ada transaksi di periode ini</text>`;
  s+=`</svg><div class="tip" id="tip" hidden></div>`;
  el.innerHTML=s;
  const tip=el.querySelector('#tip');
  el.querySelectorAll('.grp').forEach(g=>{
    g.addEventListener('mousemove',(e)=>{ const d=data[+g.dataset.i];
      tip.innerHTML=`<div class="t">${d.full}</div><div><i style="display:inline-block;width:8px;height:8px;border-radius:2px;background:var(--accent);margin-right:6px"></i>Masuk ${fM3(d.masuk)} m³</div><div><i style="display:inline-block;width:8px;height:8px;border-radius:2px;background:var(--grain);margin-right:6px"></i>Keluar ${fM3(d.keluar)} m³</div>`;
      tip.hidden=false; const r=el.getBoundingClientRect(); let x=e.clientX-r.left+12; const tw=tip.offsetWidth; if(x+tw>r.width) x=e.clientX-r.left-tw-12; tip.style.left=Math.max(0,x)+'px'; tip.style.top=Math.max(0,e.clientY-r.top-20)+'px'; });
    g.addEventListener('mouseleave',()=>tip.hidden=true); });
}
