<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Stok Opname Gudang Kayu</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: lumber-yard ledger — header, tab rail, period bar, then summary-first panels; tables scroll inside their own boxes */
:root{
  --bg:#F1F2EC; --surface:#FFFFFF; --surface-2:#E6E8DF; --line:#D2D5C9;
  --ink:#1B211D; --muted:#5C655E; --accent:#2D5A42; --accent-ink:#FFFFFF;
  --grain:#A26E26; --focus:#3C7BD9;
  --ok:#2C7546; --ok-bg:#E1EFE4; --warn:#94600A; --warn-bg:#F6EBD3; --bad:#A93528; --bad-bg:#F7E0DC;
  --font-display:"Big Shoulders Display","Arial Narrow",Impact,sans-serif;
  --font-body:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --font-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  --r:6px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#131714; --surface:#1B201C; --surface-2:#242A26; --line:#343C36;
  --ink:#E5E9E3; --muted:#99A29A; --accent:#80B996; --accent-ink:#0E1410;
  --grain:#D9A658; --focus:#7FB0FF;
  --ok:#73C38E; --ok-bg:#1E3326; --warn:#E3AB4E; --warn-bg:#3A2D14; --bad:#F07F72; --bad-bg:#3D1F1B;
  color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#131714; --surface:#1B201C; --surface-2:#242A26; --line:#343C36;
  --ink:#E5E9E3; --muted:#99A29A; --accent:#80B996; --accent-ink:#0E1410;
  --grain:#D9A658; --focus:#7FB0FF;
  --ok:#73C38E; --ok-bg:#1E3326; --warn:#E3AB4E; --warn-bg:#3A2D14; --bad:#F07F72; --bad-bg:#3D1F1B;
  color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:14px;line-height:1.5}
.wrap{max-width:1200px;margin-inline:auto;padding-block:20px 48px;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  display:flex;flex-direction:column;gap:18px}
.num,td.n,th.n{font-variant-numeric:tabular-nums}
.mono{font-family:var(--font-mono)}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}

/* header */
.top{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px}
.brand h1{font-family:var(--font-display);font-weight:700;font-size:2.4rem;line-height:1;letter-spacing:.01em;margin:0;text-transform:uppercase;text-wrap:balance}
.brand p{margin:6px 0 0;color:var(--muted)}
.meta{display:flex;flex-direction:column;align-items:flex-end;gap:4px;text-align:right}
.today{font-family:var(--font-mono);font-size:12px;color:var(--muted)}
.sync{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;color:var(--muted)}
.sync i{width:8px;height:8px;border-radius:50%;background:var(--muted)}
.sync[data-s="ok"] i{background:var(--ok)}
.sync[data-s="saving"] i{background:var(--warn)}
.sync[data-s="err"] i,.sync[data-s="off"] i{background:var(--bad)}
.sync[data-s="err"]{color:var(--bad)}
@media (prefers-reduced-motion:no-preference){.sync[data-s="saving"] i{animation:pulse 1s ease-in-out infinite}}
@keyframes pulse{50%{opacity:.3}}

/* tabs */
.tabs{display:flex;gap:4px;overflow-x:auto;border-bottom:1px solid var(--line);scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{appearance:none;background:none;border:0;border-bottom:3px solid transparent;padding:10px 12px 9px;cursor:pointer;white-space:nowrap;color:var(--muted);font-weight:500}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.panel{display:flex;flex-direction:column;gap:18px}

/* period bar */
.periode{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;display:flex;flex-direction:column;gap:10px}
.periode-row{display:flex;flex-wrap:wrap;gap:10px 14px;align-items:flex-end}
.periode .field{min-width:0}
.periode .field input{width:auto;min-width:150px}
.periode-lbl{display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;justify-content:space-between}
.periode-lbl strong{font-weight:600}
.periode-lbl .hint{font-size:12.5px}
.shift{display:inline-flex;gap:4px}
.saves{display:flex;flex-wrap:wrap;gap:6px}

/* banner */
.banner{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;background:var(--warn-bg);color:var(--ink);border:1px solid var(--line);border-radius:var(--r);padding:10px 14px}
.banner b{color:var(--warn)}

/* kpis */
.takeaway{margin:0;font-size:15px;max-width:75ch}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,165px),1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.kpi{background:var(--surface);padding:14px 16px;display:flex;flex-direction:column;gap:4px;min-width:0}
.kpi .lbl{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.kpi .val{font-family:var(--font-display);font-weight:600;font-size:2rem;line-height:1.05;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.kpi .sub{font-size:12px;color:var(--muted)}
.kpi.alert .val{color:var(--bad)}

/* cards */
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:18px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px;display:flex;flex-direction:column;gap:12px;min-width:0}
.card h2{font-size:16px;font-weight:600;margin:0}
.card .note{margin:-8px 0 0;color:var(--muted);font-size:13px}
.card-head{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;justify-content:space-between}

/* chart */
.chart{position:relative;min-height:240px}
.chart svg{display:block;width:100%;height:auto}
.legend{display:flex;gap:14px;font-size:12px;color:var(--muted)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:-1px}
.tip{position:absolute;pointer-events:none;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:0 4px 14px rgba(0,0,0,.12);padding:6px 9px;font-size:12px;white-space:nowrap;z-index:2}
.tip .t{color:var(--muted)}

/* tables */
.tbox{overflow:auto;max-height:520px;border:1px solid var(--line);border-radius:var(--r)}
table{border-collapse:collapse;width:100%;min-width:640px}
th,td{padding:8px 10px;text-align:left;border-bottom:1px solid var(--line);vertical-align:middle}
th{position:sticky;top:0;background:var(--surface-2);font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;z-index:1}
td.n,th.n{text-align:right}
tbody tr:last-child td{border-bottom:0}
tbody tr:hover td{background:color-mix(in srgb,var(--surface-2) 45%,transparent)}
td .sm{display:block;font-size:12px;color:var(--muted)}
td.tgl{white-space:nowrap}
.kode{font-family:var(--font-mono);font-size:12.5px}
.pill{display:inline-block;font-size:12px;font-weight:600;padding:2px 8px;border-radius:999px;white-space:nowrap}
.pill.ok,.pill.in{background:var(--ok-bg);color:var(--ok)}
.pill.warn,.pill.out{background:var(--warn-bg);color:var(--warn)}
.pill.bad{background:var(--bad-bg);color:var(--bad)}
.chip-contoh{font-family:var(--font-mono);font-size:10px;letter-spacing:.06em;color:var(--warn);border:1px solid currentColor;border-radius:3px;padding:0 4px;margin-left:6px;vertical-align:1px}
.pos{color:var(--ok)} .neg{color:var(--bad)}
.empty{color:var(--muted);padding:18px;text-align:center}
.sumline{font-size:13px;color:var(--muted)}
.sumline b{color:var(--ink);font-weight:600}

/* controls */
.tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.seg{display:inline-flex;flex-wrap:wrap;border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.seg button{background:var(--surface);border:0;padding:6px 10px;cursor:pointer;font-size:13px}
.seg button+button{border-left:1px solid var(--line)}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
input[type=search],input[type=text],input[type=number],input[type=date],input[type=month],select{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:7px 9px;min-width:0;width:100%}
input[type=search]{width:220px;max-width:100%}
.btn{appearance:none;border:1px solid var(--accent);background:var(--accent);color:var(--accent-ink);border-radius:var(--r);padding:8px 14px;font-weight:600;cursor:pointer}
.btn:hover{filter:brightness(1.07)}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn.small{padding:5px 10px;font-size:12.5px;font-weight:500}
.btn.danger[data-armed]{background:var(--bad);border-color:var(--bad);color:#fff}
.btn:disabled{opacity:.5;cursor:not-allowed}

/* forms */
.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:12px}
.field{display:flex;flex-direction:column;gap:4px;min-width:0}
.field label,.field .flbl{font-size:12px;font-weight:500;color:var(--muted)}
.field.wide{grid-column:1/-1}
.form-foot{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.msg{font-size:13px}
.msg.err{color:var(--bad)} .msg.ok{color:var(--ok)}
.hint{font-size:12px;color:var(--muted)}
.calc{font-family:var(--font-mono);font-size:13px;background:var(--surface-2);border-radius:var(--r);padding:7px 9px}
td input[type=number]{width:96px;text-align:right}
td input[type=text]{min-width:140px}
details.hist{border:1px solid var(--line);border-radius:var(--r);background:var(--surface)}
details.hist summary{cursor:pointer;padding:10px 14px;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center}
details.hist .tbox{border:0;border-top:1px solid var(--line);border-radius:0}
.readonly-note{color:var(--muted);font-size:13px}

.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:9px 16px;border-radius:var(--r);font-size:13px;z-index:20;max-width:calc(100% - 32px)}
@media (max-width:520px){.brand h1{font-size:1.9rem}.kpi .val{font-size:1.6rem}.meta{align-items:flex-start;text-align:left}.periode .field input{min-width:0;width:100%}.periode .field{flex:1 1 140px}}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="brand">
      <h1>Gudang Kayu</h1>
      <p>Stok opname, barang masuk dan barang keluar</p>
    </div>
    <div class="meta">
      <div class="today" id="today"></div>
      <div class="sync" id="sync" data-s="saving" role="status"><i></i><span id="syncTxt">Menghubungkan penyimpanan…</span></div>
    </div>
  </header>

  <div class="banner" id="contohBanner" hidden>
    <span><b>Data contoh.</b> Angka yang tampil masih contoh. Ganti dengan barang dan transaksi Anda sendiri.</span>
    <button class="btn small danger ghost" id="hapusContoh" type="button">Hapus data contoh</button>
  </div>
  <div class="banner" id="dbDown" hidden><span><b>Data tidak bisa disimpan.</b> Browser ini memblokir penyimpanan (mode penyamaran atau data situs diblokir). Buka file ini di browser biasa.</span></div>
  <div class="banner" id="backupNote" hidden><span><b>Simpan cadangan secara rutin.</b> Data tersimpan di browser perangkat ini saja. <span id="backupLast"></span></span><button class="btn small ghost" type="button" id="backupNow">Simpan cadangan sekarang</button></div>

  <nav class="tabs" role="tablist" aria-label="Bagian">
    <button class="tab" role="tab" data-tab="ringkasan" aria-selected="true">Ringkasan</button>
    <button class="tab" role="tab" data-tab="masuk" aria-selected="false">Barang masuk</button>
    <button class="tab" role="tab" data-tab="keluar" aria-selected="false">Barang keluar</button>
    <button class="tab" role="tab" data-tab="opname" aria-selected="false">Stok opname</button>
    <button class="tab" role="tab" data-tab="barang" aria-selected="false">Master barang</button>
  </nav>

  <!-- PERIODE -->
  <section class="periode" id="periodeBar" aria-label="Atur periode">
    <div class="periode-row">
      <div class="field"><span class="flbl">Cepat pilih</span>
        <div class="seg" role="group" aria-label="Periode cepat">
          <button type="button" data-preset="hari" aria-pressed="false">Hari ini</button>
          <button type="button" data-preset="7hari" aria-pressed="false">7 hari</button>
          <button type="button" data-preset="bulan" aria-pressed="false">Bulan ini</button>
          <button type="button" data-preset="tahun" aria-pressed="false">Tahun ini</button>
          <button type="button" data-preset="semua" aria-pressed="false">Semua</button>
        </div>
      </div>
      <div class="field"><label for="pBulan">Pilih bulan</label><input type="month" id="pBulan"></div>
      <div class="field"><label for="pDari">Dari tanggal</label><input type="date" id="pDari"></div>
      <div class="field"><label for="pSampai">Sampai tanggal</label><input type="date" id="pSampai"></div>
      <div class="field"><span class="flbl">Geser</span>
        <div class="shift"><button class="btn ghost small" type="button" id="pPrev" aria-label="Periode sebelumnya">‹ Sebelumnya</button><button class="btn ghost small" type="button" id="pNext" aria-label="Periode berikutnya">Berikutnya ›</button></div>
      </div>
    </div>
    <div class="periode-lbl">
      <span><strong id="pLabel">—</strong> <span class="hint" id="pLen"></span></span>
      <div class="saves" id="saves">
        <button class="btn ghost small" type="button" id="dlStok">Simpan laporan stok (CSV)</button>
        <button class="btn ghost small" type="button" id="dlTrx">Simpan transaksi (CSV)</button>
        <button class="btn ghost small" type="button" id="dlBackup">Cadangan semua data (JSON)</button>
        <button class="btn ghost small" type="button" id="impBtn">Pulihkan dari cadangan</button>
        <input type="file" id="impFile" accept=".json,application/json" hidden>
      </div>
    </div>
  </section>

  <!-- RINGKASAN -->
  <section class="panel" id="ringkasan" role="tabpanel">
    <p class="takeaway" id="takeaway">Memuat data gudang…</p>
    <div class="kpis">
      <div class="kpi"><span class="lbl">Nilai stok</span><span class="val" id="kNilai">—</span><span class="sub" id="kNilaiSub">per akhir periode, harga beli</span></div>
      <div class="kpi"><span class="lbl">Volume stok</span><span class="val" id="kVol">—</span><span class="sub" id="kQty">m³</span></div>
      <div class="kpi"><span class="lbl">Masuk</span><span class="val pos" id="kMasuk">—</span><span class="sub" id="kMasukSub">m³ dalam periode</span></div>
      <div class="kpi"><span class="lbl">Keluar</span><span class="val" id="kKeluar">—</span><span class="sub" id="kKeluarSub">m³ dalam periode</span></div>
      <div class="kpi" id="kRestockBox"><span class="lbl">Perlu restock</span><span class="val" id="kRestock">—</span><span class="sub">menipis atau habis</span></div>
      <div class="kpi"><span class="lbl">Selisih opname</span><span class="val" id="kSelisih">—</span><span class="sub" id="kSelisihSub">dalam periode</span></div>
    </div>

    <div class="grid2">
      <div class="card" id="cardChart">
        <div class="card-head"><h2>Mutasi kayu</h2>
          <div class="legend"><span><i style="background:var(--accent)"></i>Masuk</span><span><i style="background:var(--grain)"></i>Keluar</span></div></div>
        <p class="note" id="chartNote">Volume kayu (m³)</p>
        <div class="chart" id="chart"></div>
      </div>
      <div class="card">
        <div class="card-head"><h2>Transaksi dalam periode</h2></div>
        <p class="note" id="recentNote">Catatan masuk dan keluar terbaru</p>
        <div class="tbox" style="max-height:300px"><table style="min-width:440px"><thead><tr><th>Hari, tanggal</th><th>Jenis</th><th>Barang</th><th class="n">Qty</th></tr></thead><tbody id="recentBody"></tbody></table></div>
      </div>
    </div>

    <div class="card" id="cardStok">
      <div class="card-head"><h2>Posisi stok per barang</h2>
        <div class="tools">
          <div class="seg" role="group" aria-label="Saring status">
            <button type="button" data-filter="semua" aria-pressed="true">Semua</button>
            <button type="button" data-filter="restock" aria-pressed="false">Perlu restock</button>
          </div>
          <input type="search" id="cariStok" placeholder="Cari kode, nama, jenis kayu" aria-label="Cari barang">
        </div>
      </div>
      <p class="note" id="stokNote">Stok akhir = stok awal periode + masuk − keluar ± penyesuaian opname</p>
      <div class="tbox"><table style="min-width:980px"><thead><tr>
        <th>Kode</th><th>Barang</th><th class="n">Stok awal</th><th class="n">Masuk</th><th class="n">Keluar</th><th class="n">Penyesuaian</th><th class="n">Stok akhir</th><th class="n">Volume</th><th class="n">Nilai</th><th>Status</th>
      </tr></thead><tbody id="stokBody"></tbody></table></div>
    </div>
  </section>

  <!-- MASUK -->
  <section class="panel" id="masuk" role="tabpanel" hidden>
    <div class="card">
      <h2>Catat barang masuk</h2>
      <p class="note">Kayu yang diterima dari pemasok atau hasil gergajian</p>
      <form class="form writer" id="formMasuk" novalidate>
        <div class="field"><label for="mTgl">Tanggal</label><input type="date" id="mTgl" required><span class="hint" id="mTglHari"></span></div>
        <div class="field"><label for="mDok">No. faktur / surat jalan</label><input type="text" id="mDok" placeholder="SJ-0123"></div>
        <div class="field"><label for="mPihak">Pemasok</label><input type="text" id="mPihak" placeholder="Nama pemasok"></div>
        <div class="field wide"><label for="mKode">Barang</label><select id="mKode" required></select></div>
        <div class="field"><label for="mQty">Jumlah</label><input type="number" id="mQty" min="1" step="1" inputmode="numeric" required></div>
        <div class="field"><label for="mHarga">Harga beli / satuan (Rp)</label><input type="number" id="mHarga" min="0" step="1" inputmode="numeric"></div>
        <div class="field"><span class="flbl">Total</span><div class="calc" id="mTotal">—</div></div>
        <div class="form-foot"><button class="btn" type="submit">Simpan barang masuk</button><span class="msg" id="mMsg" role="status"></span></div>
      </form>
      <p class="readonly-note reader" hidden>Anda hanya bisa melihat data. Minta pemilik memberi akses Contributor untuk mencatat transaksi.</p>
    </div>
    <div class="card">
      <div class="card-head"><h2>Riwayat barang masuk</h2><input type="search" id="cariMasuk" placeholder="Cari faktur, pemasok, barang" aria-label="Cari barang masuk"></div>
      <p class="sumline" id="masukSum"></p>
      <div class="tbox"><table style="min-width:860px"><thead><tr><th>Hari, tanggal</th><th>No. dokumen</th><th>Pemasok</th><th>Barang</th><th class="n">Qty</th><th class="n">m³</th><th class="n">Total</th><th></th></tr></thead><tbody id="masukBody"></tbody></table></div>
    </div>
  </section>

  <!-- KELUAR -->
  <section class="panel" id="keluar" role="tabpanel" hidden>
    <div class="card">
      <h2>Catat barang keluar</h2>
      <p class="note">Penjualan, pemakaian proyek, atau kayu rusak</p>
      <form class="form writer" id="formKeluar" novalidate>
        <div class="field"><label for="kTgl">Tanggal</label><input type="date" id="kTgl" required><span class="hint" id="kTglHari"></span></div>
        <div class="field"><label for="kDok">No. nota</label><input type="text" id="kDok" placeholder="NT-0456"></div>
        <div class="field"><label for="kPihak">Pelanggan / tujuan</label><input type="text" id="kPihak" placeholder="Nama pelanggan"></div>
        <div class="field wide"><label for="kKode">Barang</label><select id="kKode" required></select><span class="hint" id="kStokInfo"></span></div>
        <div class="field"><label for="kQty">Jumlah</label><input type="number" id="kQty" min="1" step="1" inputmode="numeric" required></div>
        <div class="field"><label for="kHarga">Harga jual / satuan (Rp)</label><input type="number" id="kHarga" min="0" step="1" inputmode="numeric"></div>
        <div class="field"><span class="flbl">Total</span><div class="calc" id="kTotal">—</div></div>
        <div class="form-foot"><button class="btn" type="submit">Simpan barang keluar</button><span class="msg" id="kMsg" role="status"></span></div>
      </form>
      <p class="readonly-note reader" hidden>Anda hanya bisa melihat data. Minta pemilik memberi akses Contributor untuk mencatat transaksi.</p>
    </div>
