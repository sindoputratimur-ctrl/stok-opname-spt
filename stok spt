function makeLocalDB(){
  let store; let ok=true;
  try{ const raw=localStorage.getItem(KEY); store = raw ? JSON.parse(raw) : null;
    if(!store){ store=JSON.parse(JSON.stringify(SEED)); localStorage.setItem(KEY,JSON.stringify(store)); } }
  catch(e){ ok=false; store=JSON.parse(JSON.stringify(SEED)); }
  for(const c of ['barang','mutasi','opname']) store[c]=store[c]||{};
  const subs={barang:[],mutasi:[],opname:[]};
  const snap=(c)=>{ const docs=Object.keys(store[c]).map(id=>({id,exists:true,data:()=>store[c][id]})); return {docs,size:docs.length,empty:!docs.length}; };
  const emit=(c)=>subs[c].forEach(fn=>fn(snap(c)));
  const persist=()=>{ if(!ok) throw {code:'unavailable'}; try{ localStorage.setItem(KEY,JSON.stringify(store)); }catch(e){ throw {code:'quota_exceeded'}; } };
  const id=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,8);
  const docRef=(c,i)=>({ set:async(d)=>{ const prev=store[c][i]; store[c][i]=JSON.parse(JSON.stringify(d)); try{ persist(); }catch(e){ if(prev===undefined) delete store[c][i]; else store[c][i]=prev; throw e; } emit(c); },
    delete:async()=>{ const prev=store[c][i]; delete store[c][i]; try{ persist(); }catch(e){ if(prev!==undefined) store[c][i]=prev; throw e; } emit(c); } });
  window.addEventListener('storage',(e)=>{ if(e.key!==KEY||!e.newValue) return; try{ store=JSON.parse(e.newValue); ['barang','mutasi','opname'].forEach(c=>{ store[c]=store[c]||{}; emit(c); }); }catch(err){} });
  return { ok,
    doc:(p)=>{ const [c,i]=p.split('/'); return docRef(c,i); },
    collection:(c)=>({ add:async(d)=>{ const i=id(); await docRef(c,i).set(d); return {id:i}; },
      onSnapshot:(fn)=>{ subs[c].push(fn); setTimeout(()=>fn(snap(c))); return ()=>{ subs[c]=subs[c].filter(x=>x!==fn); }; } }),
    importAll:(obj)=>{ const before=JSON.stringify(store); let n=0;
      (obj.barang||[]).forEach(b=>{ if(b&&b.kode){ const {id:_,...rest}=b; store.barang[b.kode]=rest; n++; } });
      ['mutasi','opname'].forEach(c=>(obj[c]||[]).forEach(d=>{ if(d&&d.id){ const {id:i,...rest}=d; store[c][i]=rest; n++; } }));
      try{ persist(); }catch(e){ store=JSON.parse(before); throw e; } ['barang','mutasi','opname'].forEach(emit); return n; } };
}
