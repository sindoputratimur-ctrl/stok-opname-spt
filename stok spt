  applyWrite(); renderBackup();
  const loadedNow=()=>{ if(db.ok && S.loaded.barang&&S.loaded.mutasi&&S.loaded.opname&&!S.pending) setSync('ok'); };
  db.collection('barang').onSnapshot(s=>{ S.barang={}; s.docs.forEach(d=>{ const x=d.data(); S.barang[d.id]={...x,kode:d.id}; }); S.loaded.barang=true; loadedNow(); renderAll(); });
  db.collection('mutasi').onSnapshot(s=>{ S.mutasi=s.docs.map(d=>({...d.data(),id:d.id})); S.loaded.mutasi=true; loadedNow(); renderAll(); });
  db.collection('opname').onSnapshot(s=>{ S.opname=s.docs.map(d=>({...d.data(),id:d.id})); S.loaded.opname=true; loadedNow(); renderAll(); });
})();
})();
</script>

